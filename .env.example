# Docker images (Debian-based, not alpine)
POSTGRES_IMAGE=postgres:16
RABBITMQ_IMAGE=rabbitmq:3-management
JSREPORT_IMAGE=jsreport/jsreport
LOKI_IMAGE=grafana/loki:3.4.2
PROMTAIL_IMAGE=grafana/promtail:3.4.2
GRAFANA_IMAGE=grafana/grafana:11.5.2

# PostgreSQL credentials (shared across instances)
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# RabbitMQ credentials
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3001

# Host ports
POSTGRES_CLIENT_PORT=5488
POSTGRES_APPLICATION_PORT=5489
POSTGRES_REPORT_PORT=5487
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
JSREPORT_PORT=5485
LOKI_PORT=3100

# Application ports (phase 2)
CLIENT_SERVICE_PORT=8080
APPLICATION_SERVICE_PORT=8082
GATEWAY_PORT=8088
UI_PORT=3000
REACT_APP_API_BASE_URL=http://localhost:8088
REACT_APP_INITIATOR_LOGIN=operator
